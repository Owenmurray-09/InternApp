    name text,
    bio text,
    interests text[] DEFAULT '{}'::text[],
    location text,
    avatar_url text,
    daily_digest_enabled boolean DEFAULT false,
    created_at timestamp with time zone DEFAULT now(),
    phone text,
    experience text,
    CONSTRAINT profiles_role_check CHECK ((role = ANY (ARRAY['student'::text, 'employer'::text])))
);


ALTER TABLE public.profiles OWNER TO postgres;

--
-- Name: COLUMN profiles.daily_digest_enabled; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.profiles.daily_digest_enabled IS 'Student preference for daily digest notifications vs immediate notifications';


--
-- Name: recommendations; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.recommendations (
    id uuid DEFAULT extensions.uuid_generate_v4() NOT NULL,
    employer_id uuid NOT NULL,
    student_id uuid NOT NULL,
    job_id uuid,
    content text,
    created_at timestamp with time zone DEFAULT now()
);


ALTER TABLE public.recommendations OWNER TO postgres;

