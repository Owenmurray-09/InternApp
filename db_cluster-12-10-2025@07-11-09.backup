--
-- Name: applications; Type: ROW SECURITY; Schema: public; Owner: postgres
--

ALTER TABLE public.applications ENABLE ROW LEVEL SECURITY;

--
-- Name: applications apps employer read; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "apps employer read" ON public.applications FOR SELECT USING ((EXISTS ( SELECT 1
   FROM (public.jobs j
     JOIN public.companies c ON ((j.company_id = c.id)))
  WHERE ((j.id = applications.job_id) AND (c.owner_user_id = auth.uid())))));


--
-- Name: applications apps student manage; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "apps student manage" ON public.applications USING ((auth.uid() = student_user_id)) WITH CHECK ((auth.uid() = student_user_id));


--
-- Name: comments; Type: ROW SECURITY; Schema: public; Owner: postgres
--

ALTER TABLE public.comments ENABLE ROW LEVEL SECURITY;

--
-- Name: comments comments read; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "comments read" ON public.comments FOR SELECT USING (true);


--
-- Name: comments comments write own; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "comments write own" ON public.comments USING ((auth.uid() = author_user_id)) WITH CHECK ((auth.uid() = author_user_id));


--
-- Name: companies; Type: ROW SECURITY; Schema: public; Owner: postgres
--

ALTER TABLE public.companies ENABLE ROW LEVEL SECURITY;

--
-- Name: companies company owner modify; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "company owner modify" ON public.companies USING ((auth.uid() = owner_user_id)) WITH CHECK ((auth.uid() = owner_user_id));


--
-- Name: companies company select public; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "company select public" ON public.companies FOR SELECT USING (true);


--
-- Name: events; Type: ROW SECURITY; Schema: public; Owner: postgres
--

ALTER TABLE public.events ENABLE ROW LEVEL SECURITY;

--
-- Name: events events organizer manage; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "events organizer manage" ON public.events USING ((auth.uid() = organizer_user_id)) WITH CHECK ((auth.uid() = organizer_user_id));


--
-- Name: events events participant read; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "events participant read" ON public.events FOR SELECT USING (((auth.uid() = participant_user_id) OR (auth.uid() = organizer_user_id)));


--
-- Name: jobs; Type: ROW SECURITY; Schema: public; Owner: postgres
--

ALTER TABLE public.jobs ENABLE ROW LEVEL SECURITY;

--
-- Name: jobs jobs owner write; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "jobs owner write" ON public.jobs USING ((EXISTS ( SELECT 1
   FROM public.companies c
  WHERE ((c.id = jobs.company_id) AND (c.owner_user_id = auth.uid()))))) WITH CHECK ((EXISTS ( SELECT 1
   FROM public.companies c
  WHERE ((c.id = jobs.company_id) AND (c.owner_user_id = auth.uid())))));


--
-- Name: jobs jobs readable; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "jobs readable" ON public.jobs FOR SELECT USING (true);


--
-- Name: messages; Type: ROW SECURITY; Schema: public; Owner: postgres
--

ALTER TABLE public.messages ENABLE ROW LEVEL SECURITY;

--
-- Name: messages messages participants; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "messages participants" ON public.messages USING ((EXISTS ( SELECT 1
   FROM public.threads t
  WHERE ((t.id = messages.thread_id) AND ((auth.uid() = t.employer_user_id) OR (auth.uid() = t.student_user_id)))))) WITH CHECK ((EXISTS ( SELECT 1
   FROM public.threads t
  WHERE ((t.id = messages.thread_id) AND ((auth.uid() = t.employer_user_id) OR (auth.uid() = t.student_user_id))))));


--
-- Name: student_preferences prefs student manage; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "prefs student manage" ON public.student_preferences USING ((auth.uid() = student_user_id)) WITH CHECK ((auth.uid() = student_user_id));


--
-- Name: profiles profiles_delete_own; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY profiles_delete_own ON public.profiles FOR DELETE USING ((auth.uid() = id));


--
-- Name: profiles profiles_insert_own; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY profiles_insert_own ON public.profiles FOR INSERT WITH CHECK ((auth.uid() = id));


--
-- Name: profiles profiles_select_own; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY profiles_select_own ON public.profiles FOR SELECT USING ((auth.uid() = id));


--
-- Name: profiles profiles_update_own; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY profiles_update_own ON public.profiles FOR UPDATE USING ((auth.uid() = id)) WITH CHECK ((auth.uid() = id));


